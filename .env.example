# Copie para .env e preencha antes de rodar `docker compose up`.

# Segredo usado para assinar os JWTs. Gere um valor aleatório forte,
# nunca reaproveite o exemplo abaixo em produção.
NEXUS_JWT_SECRET=troque-este-segredo-em-producao-1234567890

# URL pública do frontend, usada nos links dos e-mails (convite, redefinição
# de senha). Deve bater com a porta publicada do serviço `frontend`.
NEXUS_FRONTEND_URL=http://localhost:8082

# URL do backend vista pelo navegador (não pela rede interna do Docker),
# embutida no build do frontend.
NEXUS_API_URL=http://localhost:8080

# E-mail transacional (convite / redefinição de senha). Deixe
# NEXUS_MAIL_ENABLED=false para só logar o conteúdo em vez de enviar de verdade.
NEXUS_MAIL_ENABLED=false
NEXUS_MAIL_USERNAME=
NEXUS_MAIL_PASSWORD=

# Senha do usuário admin do Grafana (http://localhost:3001, usuário "admin").
NEXUS_GRAFANA_PASSWORD=admin
